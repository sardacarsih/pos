# Salin menjadi .env (di-gitignore) atau set sebagai environment variable.
# Connection string hanya ada di server; jangan commit .env asli.
POS_BIND=0.0.0.0:8080
POS_DB_USER=YOUR_USER
POS_DB_PASSWORD=YOUR_PASSWORD
POS_DB_CONNECT=//YOUR_HOST:1521/YOUR_SERVICE
POS_DB_POOL_MAX=10
# Minimal 32 karakter acak, jangan dipakai ulang.
POS_JWT_SECRET=GANTI_DENGAN_RAHASIA_ACAK_MINIMAL_32_KARAKTER
POS_DEFAULT_CUSTOMER_NIK=00.00004
# true bila di belakang reverse proxy (HTTPS dihentikan di proxy) agar IP klien dibaca dari X-Forwarded-For
POS_TRUST_PROXY=true
# Batas tenor bila FIN_SETTINGS MAXANGSURAN tidak ada
POS_DEFAULT_MAX_TENOR=12
# Belanja mandiri anggota: true (default) = simulasi, tidak menyimpan faktur; false = transaksi nyata
POS_BELANJA_MANDIRI_DEMO=true
# FCM opsional: aktifkan keduanya di server, jangan commit kredensial.
# POS_FCM_PROJECT_ID=project-firebase
# GOOGLE_APPLICATION_CREDENTIALS=/path/privat/firebase-service-account.json
